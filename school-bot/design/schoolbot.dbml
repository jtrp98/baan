  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Global content only; CHECK (SchoolId IS NULL)']

  indexes {
    (LevelId, Revision) [unique, name: 'UQ_SchoolBotLevelPromotionPolicy_Level_Revision']
  }

  Note: 'หน้าที่: เก็บเกณฑ์ค่าเฉลี่ยสำหรับเสนอเลื่อน Level โดยเก็บประวัติการเปลี่ยนเกณฑ์ | หนึ่งแถว: เกณฑ์หนึ่ง revision สำหรับ Level หนึ่ง | ใช้เมื่อ: ส่วนกลางเพิ่ม revision เกณฑ์; LevelProposal อ่าน revision ที่ใช้ประเมิน | ตัวอย่าง: สมมติ: เกณฑ์ 70 หมายถึงค่าเฉลี่ย 70 ยังไม่ผ่าน แต่ค่าที่สูงกว่า 70 จึงเข้าเงื่อนไข | ขอบเขต: ข้อมูลส่วนกลาง: SchoolId ต้องเป็น NULL; โรงเรียนใช้เนื้อหาร่วมกัน | คู่มือ: data-dictionary/table-011.md | ข้อกำหนดเดิม: SchoolBot DB (DES-011 Rev3). เกณฑ์คะแนนเฉลี่ยของห้องราย Level ที่ตั้งโดย level_policy_admin; immutable ต่อ revision.'
}

Table SchoolBotCurriculum [headercolor: #059669] {
  SchoolBotCurriculumId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotCurriculum (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  CurriculumKey uuid [not null, note: 'UUID ของหลักสูตรที่คงเดิมข้าม revision | ข้อกำหนดเดิม: Logical key across revisions']
  Revision int4 [not null, note: 'เลขฉบับหลักสูตร; คู่ CurriculumKey/Revision ไม่ซ้ำ และฉบับเผยแพร่แล้วไม่ย้อนแก้เนื้อหา']
  LevelId int4 [not null, note: 'FK ไป SchoolBotLevel ของหลักสูตรฉบับนี้']
  Title jsonb [not null, note: 'ชื่อหลักสูตรหลายภาษาแบบ Text ใช้แสดงรายการและหัวหลักสูตร | ข้อกำหนดเดิม: Text localized object']
  RecommendedGrades jsonb [not null, note: 'JSON array ระดับชั้นที่แนะนำ เช่น ป.4; เป็นคำแนะนำ ไม่ใช่เงื่อนไขห้ามชั้นอื่นเรียน | ข้อกำหนดเดิม: T16[] recommended grade codes; default guidance only']
  Subjects jsonb [not null, note: 'JSON รายวิชากลาง แต่ละรายการมี subject_key, code, title; ไม่ใช่รหัส TPlane ของโรงเรียน | ข้อกำหนดเดิม: CurriculumSubject[] {subject_key, code, title}']
  SourceRef varchar(2048) [not null, note: 'แหล่งอ้างอิงเนื้อหา เช่น Course Plan หรือเอกสารต้นทาง เพื่อย้อนตรวจที่มา']
  Lifecycle SchoolBotContentState [not null, note: 'draft=กำลังจัดทำ, published=อนุมัติให้เลือกใช้, retired=เลิกให้เลือกใช้ใหม่โดยยังเก็บประวัติ']
  PublishedAt timestamptz [null, note: 'เวลา UTC เผยแพร่หลักสูตร; null เมื่อยังไม่มีการเผยแพร่ และต้องมีค่าเมื่อ published']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Global content only; CHECK (SchoolId IS NULL)']

  indexes {
    (CurriculumKey, Revision) [unique, name: 'UQ_SchoolBotCurriculum_Key_Revision']
  }

  Note: 'หน้าที่: เก็บหลักสูตรกลางเป็นราย revision เพื่อให้แต่ละห้องเลือกใช้เนื้อหาฉบับแน่นอน | หนึ่งแถว: หนึ่ง revision ของหลักสูตรหนึ่งสำหรับ Level หนึ่ง | ใช้เมื่อ: ส่วนกลางสร้างร่าง/อนุมัติเผยแพร่; โรงเรียนเลือกเปิด CourseRun; ผู้เรียนอ่านบทเรียน | ตัวอย่าง: สมมติ: หลักสูตร Beginner revision 2 มีทั้งกิจกรรม Block, Arm และ Quiz | ขอบเขต: ข้อมูลส่วนกลาง: SchoolId ต้องเป็น NULL; โรงเรียนใช้เนื้อหาร่วมกัน | คู่มือ: data-dictionary/table-012.md | ข้อกำหนดเดิม: SchoolBot DB (DES-005 Rev5). เนื้อหากลางของ SchoolBright (SchoolId IS NULL); ถอน Mode ออกจาก Curriculum ไปไว้ที่ Activity ตาม decisions-026; publish ต้องผ่าน four-eyes.'
}

