Table SchoolBotLicense [headercolor: #2563EB] {
  SchoolBotLicenseId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotLicense (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  SchoolName varchar(200) [not null, note: 'ชื่อโรงเรียนที่บันทึกประกอบใบอนุญาต ไม่ใช่รหัสเชื่อมโรงเรียน; การเชื่อมใช้ SchoolId']
  KeyHash varchar(64) [not null, unique, note: 'ค่า SHA-256 สำหรับตรวจ License Key โดยไม่เก็บ Key ฉบับอ่านได้; ห้ามซ้ำทั้งระบบ | ข้อกำหนดเดิม: UQ_SchoolBotLicense_KeyHash; SHA-256 hex 64 characters']
  KeyHint varchar(32) [not null, note: 'ข้อความช่วยให้ผู้ดูแลแยกแยะ Key โดยไม่แสดง Key เต็ม']
  ExpiresAt timestamptz [not null, note: 'เวลา UTC ที่ใบอนุญาตหมดอายุ; เมื่อถึงเวลานี้ใช้ต่อไม่ได้']
  RevokedAt timestamptz [null, note: 'เวลา UTC ที่ถอนใบอนุญาตก่อนหมดอายุ; null หมายถึงยังไม่มีการถอน']
  CurrentBindingId int4 [null, note: 'ชี้ SchoolBotLicenseBinding ที่ผูกอยู่ปัจจุบัน; null หมายถึงไม่มี binding ปัจจุบัน และไม่ได้แปลว่า License หมดอายุ']
  BindingEpoch int4 [not null, note: 'เลขรุ่นของการผูกเครื่อง ใช้แยกสิทธิ์เครื่องก่อนและหลังย้ายเครื่อง; ไม่ใช่ row ID | ข้อกำหนดเดิม: Positive epoch; advance when binding changes']
  AllowedNextJkt varchar(64) [null, note: 'ลายนิ้วมือ public key ของเครื่องที่ผู้ดูแลระบุให้ activate ครั้งถัดไป; null หมายถึงไม่ได้ระบุเครื่องถัดไปเฉพาะเจาะจง แต่ยังต้องตรวจประวัติเครื่องที่ถูกถอด']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotLicense_SchoolId_Pos: SchoolId > 0']

  Note: 'หน้าที่: เก็บสิทธิ์ใช้งาน SchoolBot ของโรงเรียน รวมวันหมดอายุและเครื่องที่ผูกอยู่ | หนึ่งแถว: หนึ่งใบอนุญาตของหนึ่งโรงเรียน | ใช้เมื่อ: ผู้ดูแลออก/ถอนใบอนุญาต; Desktop activate/validate; เว็บโรงเรียนตรวจสิทธิ์ใช้งาน | ตัวอย่าง: สมมติ: โรงเรียน ก มีใบอนุญาตที่ยังใช้งานได้ และผูกกับคอมพิวเตอร์ห้องหุ่นยนต์ | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-001.md | ข้อกำหนดเดิม: SchoolBot DB (10.0.0.128:9499; DES-002, DES-004, DES-012). ใช้ตรวจสิทธิ์ทั้งช่อง desktop (ต้องมี active License + device binding) และช่อง school_web (ต้องมี active License ของโรงเรียนโดยไม่ต้องมี device binding ตาม decisions-025/026). FK_SchoolBotLicense_CurrentBinding เป็น DEFERRABLE INITIALLY DEFERRED.'
}

Table SchoolBotLicenseBinding [headercolor: #2563EB] {
  SchoolBotLicenseBindingId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotLicenseBinding (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  LicenseId int4 [not null, note: 'FK ไป SchoolBotLicense เจ้าของการผูกเครื่องนี้']
  DeviceJkt varchar(64) [not null, note: 'ลายนิ้วมือ public key ของ installation; ใช้ตรวจ device proof ไม่ใช่เลขเครื่องทางกายภาพ']
  PublicJwk jsonb [not null, note: 'JSON public key แบบ EC/P-256 สำหรับตรวจลายเซ็นเครื่อง มี kty, crv, x, y; ไม่เก็บ private key | ข้อกำหนดเดิม: DES-002: public EC P-256 JWK only; no private key']
  Epoch int4 [not null, note: 'เลขรุ่นของ binding ภายใน License; คู่ LicenseId/Epoch ไม่ซ้ำ']
  ActivatedAt timestamptz [not null, note: 'เวลา UTC ที่การผูกเครื่องนี้เริ่มมีผล']
  DetachedAt timestamptz [null, note: 'เวลา UTC ที่ถอดเครื่องออก; null หมายถึงยังไม่ถูกถอด แต่ต้องตรวจ License และ current binding ร่วมด้วย']
  LastCheckedAt timestamptz [not null, note: 'เวลา UTC ของการตรวจออนไลน์ล่าสุดที่ออกสิทธิ์ให้; replay คำขอเดิมไม่ถือเป็นการตรวจใหม่']
  LastEntitlementExpiresAt timestamptz [not null, note: 'เวลา UTC ที่ entitlement ล่าสุดหมดอายุ; ไม่เกิน LastCheckedAt บวก 259200 วินาที หรือ 3 วัน และตามสัญญาต้องไม่เกิน License.ExpiresAt | ข้อกำหนดเดิม: CK_SchoolBotLicenseBinding_LeaseWindow: <= LastCheckedAt + 259200s']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotLicenseBinding_SchoolId_Pos: SchoolId > 0']

  indexes {
    (LicenseId, Epoch) [unique, name: 'UQ_SchoolBotLicenseBinding_LicenseId_Epoch']
  }

  Note: 'หน้าที่: เก็บประวัติการผูกใบอนุญาตกับ installation key และอายุสิทธิ์ออฟไลน์ที่ออกให้ | หนึ่งแถว: การผูก License กับ device key หนึ่งครั้งในหนึ่ง Epoch | ใช้เมื่อ: activate สร้าง binding; validate ต่ออายุ entitlement; unbind ปิด binding เดิม | ตัวอย่าง: สมมติ: ย้าย License จากเครื่องเก่าไปเครื่องใหม่ โดยเก็บ binding เก่าไว้เป็นประวัติ | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-002.md | ข้อกำหนดเดิม: SchoolBot DB (DES-002). มี active binding ได้ไม่เกินหนึ่งต่อ License; LastEntitlementExpiresAt <= License.ExpiresAt และ <= LastCheckedAt + 259200 วินาที.'
}

Table SchoolBotRelease [headercolor: #475569] {
  SchoolBotReleaseId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotRelease (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  VersionText varchar(32) [not null, note: 'เลขรุ่นซอฟต์แวร์รูป x.y.z เช่น 2.1.0; ไม่ใช่ concurrency token']
  Channel SchoolBotChannel [not null, note: 'ช่องแจกจ่าย stable สำหรับรุ่นปกติ หรือ beta สำหรับรุ่นทดลอง']
  Platform SchoolBotPlatform [not null, note: 'ระบบและสถาปัตยกรรมที่ไฟล์รองรับ: windows-amd64, darwin-amd64 หรือ darwin-arm64']
  Manifest varchar(16384) [not null, note: 'ข้อความ JWS ที่ลงนามแล้ว ระบุ release ID, URL, SHA-256, ขนาดเป็น bytes, ชนิด package, OS ขั้นต่ำ และข้อมูล engine ตาม DES-007 | ข้อกำหนดเดิม: DES-007 signed JWS string']
  ArtifactHash varchar(64) [not null, note: 'SHA-256 ของไฟล์แจกจ่ายหลัง signing/notarization ใช้ตรวจว่าไฟล์ตรงกับรุ่นที่ประกาศ']
  Lifecycle SchoolBotReleaseState [not null, note: 'draft=ร่าง, published=เผยแพร่ให้ใช้, withdrawn=ถอนจากการแจกจ่าย']
  PublishedAt timestamptz [null, note: 'เวลา UTC ที่เผยแพร่; null เมื่อยังไม่มีเวลาเผยแพร่ และต้องมีค่าเมื่อ Lifecycle=published']
  WithdrawnAt timestamptz [null, note: 'เวลา UTC ที่ถอนรุ่น; null เมื่อยังไม่มีการถอน ไม่ใช่หลักฐานว่าถอน binary ที่ติดตั้งไปแล้ว']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotRelease_SchoolId_Scope: SchoolId IS NULL OR SchoolId > 0']

  Note: 'หน้าที่: เก็บรายการรุ่นซอฟต์แวร์และ manifest ที่ลงนามสำหรับตรวจสอบไฟล์ติดตั้ง | หนึ่งแถว: หนึ่งเวอร์ชัน ต่อ channel ต่อ platform ใน catalog กลางหรือของโรงเรียนหนึ่ง | ใช้เมื่อ: ผู้เผยแพร่สร้าง/เผยแพร่/ถอนรุ่น; Desktop ตรวจอัปเดตและตรวจความน่าเชื่อถือก่อนติดตั้ง | ตัวอย่าง: สมมติ: รุ่น 2.1.0 ช่อง stable สำหรับ windows-amd64 | ขอบเขต: รองรับทั้งส่วนกลาง (SchoolId=NULL) และรายโรงเรียน (SchoolId>0) | คู่มือ: data-dictionary/table-003.md | ข้อกำหนดเดิม: SchoolBot DB (DES-007). รองรับทั้ง global catalog (SchoolId IS NULL) และ targeted release รายโรงเรียน.'
}

Table SchoolBotIdempotency [headercolor: #64748B] {
  SchoolBotIdempotencyId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotIdempotency (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  Principal varchar(512) [not null, note: 'ตัวตนผู้เรียกแบบมีชนิดและขอบเขต เช่น account, web, staff, device หรือ service; ไม่ใช่เลขผู้ใช้เดี่ยว']
  Operation varchar(200) [not null, note: 'ชื่อ operation ที่แยกขอบเขตคำสั่ง เช่น การสร้าง resource คนละประเภทต้องไม่ใช้ผลแทนกัน']
  RequestKey uuid [not null, note: 'UUID จาก Idempotency-Key ใช้ระบุคำสั่งเดิมขณะ retry']
  RequestHash varchar(64) [not null, note: 'SHA-256 ของ request ที่ทำ canonical แล้ว; Key เดิมแต่เนื้อหาต่างต้องเป็น conflict']
  NonceHash varchar(64) [null, note: 'hash ของ nonce สำหรับกัน replay ของ device challenge; null เมื่อ operation ไม่ใช้ nonce | ข้อกำหนดเดิม: NonceHash ที่ไม่เป็น NULL ต้องไม่ซ้ำ; application ต้องบังคับแบบ atomic ไม่มี standalone index ใน DDL']
  HttpStatus int4 [not null, note: 'HTTP status ของผลที่บันทึกไว้สำหรับ replay ตามสัญญาช่วง 100–599']
  ResultCipher bytea [null, note: 'response ที่เข้ารหัสเป็น bytes; null เมื่อไม่มี ciphertext ให้ replay รวมกรณีล้างหลังหมดอายุ']
  ResultKeyId varchar(128) [null, note: 'ชื่ออ้างอิงกุญแจที่ใช้เข้ารหัส ResultCipher ไม่ใช่ตัวกุญแจ; null พร้อม ResultCipher']
  ResourceId int4 [null, note: 'PK ของ SchoolBot resource หลักที่ operation สร้างหรือคืน; null เมื่อไม่มี resource ที่ระบุได้ โดยชนิดตารางต้องดู Operation']
  CompletedAt timestamptz [not null, note: 'เวลา UTC ที่คำสั่งเสร็จและบันทึกผล']
  ReplayUntil timestamptz [not null, note: 'เวลา UTC สิ้นสุดช่วง replay response ที่เข้ารหัส; สัญญากำหนด 24 ชั่วโมง หลังจากนั้นยังเก็บ tombstone กันทำซ้ำ']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotIdempotency_SchoolId_Scope: SchoolId IS NULL OR SchoolId > 0']

  Note: 'หน้าที่: จำผลคำสั่งเพื่อให้การส่งคำขอซ้ำไม่สร้างข้อมูลหรือทำธุรกรรมซ้ำ | หนึ่งแถว: ผลคำสั่งหนึ่งชุด ภายใต้โรงเรียน ผู้กระทำ Operation และ RequestKey เดียวกัน | ใช้เมื่อ: API mutation ตรวจคำขอซ้ำ บันทึกผลร่วมกับ domain transaction และคืนผล replay | ตัวอย่าง: สมมติ: บันทึกโครงงานสำเร็จแต่เครือข่ายขาด การ retry ด้วย RequestKey เดิมได้รับผลเดิม | ขอบเขต: รองรับทั้งส่วนกลาง (SchoolId=NULL) และรายโรงเรียน (SchoolId>0) | คู่มือ: data-dictionary/table-004.md | ข้อกำหนดเดิม: SchoolBot DB. บันทึก idempotency ร่วม transaction เดียวกับ domain mutation ใน SchoolBot DB.'
}

Table SchoolBotAuditEvent [headercolor: #64748B] {
  SchoolBotAuditEventId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotAuditEvent (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  Actor varchar(512) [not null, note: 'ตัวตนผู้กระทำแบบมีชนิดและโรงเรียน แยกนักเรียน พนักงาน legacy admin เครื่อง และระบบได้ชัดกว่า CreateBy']
  Event varchar(64) [not null, note: 'ชื่อเหตุการณ์หรือ operation ตาม DES เพื่อบอกว่าเกิดการสร้าง ยืนยัน ถอน หรือเปลี่ยนสถานะใด']
  EntityType varchar(64) [not null, note: 'ชื่อตาราง SchoolBot ที่เหตุการณ์อ้างถึง ใช้ตีความ EntityId']
  EntityId int4 [not null, note: 'PK ของ resource ตาม EntityType; เป็น logical reference เพราะคอลัมน์เดียวอ้างได้หลายตาราง']
  RequestId uuid [not null, note: 'UUID เชื่อมเหตุการณ์กับคำขอหรือกระบวนการเดียวกันสำหรับติดตามปัญหา']
  Reason varchar(1000) [not null, note: 'เหตุผลหรือหลักฐานประกอบการกระทำ ไม่ใส่ password, Key, token, claims ทั้งก้อน หรือ source ของนักเรียน']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotAuditEvent_SchoolId_Scope: SchoolId IS NULL OR SchoolId > 0']

  Note: 'หน้าที่: เก็บร่องรอยว่าใครทำอะไรกับข้อมูล SchoolBot เพื่อย้อนตรวจเหตุการณ์ | หนึ่งแถว: หนึ่งเหตุการณ์ของหนึ่ง resource; เป็นประวัติแบบ append-only | ใช้เมื่อ: API และ worker บันทึกเหตุการณ์ใน transaction ของ SchoolBot; ผู้มีสิทธิ์อ่านประวัติ | ตัวอย่าง: สมมติ: ครูยืนยันส่งคะแนนใบหนึ่ง และระบบบันทึกผู้ยืนยันกับ RequestId | ขอบเขต: รองรับทั้งส่วนกลาง (SchoolId=NULL) และรายโรงเรียน (SchoolId>0) | คู่มือ: data-dictionary/table-005.md | ข้อกำหนดเดิม: SchoolBot DB. Append-only audit trail (ไม่มี PreviousVersion/NewVersion ตาม decisions-030).'
}

Table SchoolBotSession [headercolor: #7C3AED] {
  SchoolBotSessionId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotSession (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  Channel SchoolBotSessionChannel [not null, default: 'desktop', note: 'desktop=เรียน/ทดลอง, school_web=งานโรงเรียน, staff_admin=งานส่วนกลาง; ใช้จำกัด endpoint ที่เรียกได้; ค่าเริ่มต้นใน SQL = \'desktop\' | ข้อกำหนดเดิม: desktop|school_web|staff_admin']
  AccountId int4 [null, note: 'รหัสบัญชี TMasterDBUser.sID; Desktop ต้องมีค่า ส่วนช่องเว็บอาจ null; ห้ามถือว่าเท่ากับ TUser.sID หรือ TEmployees.sEmp | ข้อกำหนดเดิม: Legacy Master TMasterDBUser.sID; NOT NULL when Channel = desktop']
  TokenHash varchar(64) [not null, unique, note: 'SHA-256 ของ opaque access token สำหรับค้นหา session; ไม่เก็บ raw token | ข้อกำหนดเดิม: UQ_SchoolBotSession_TokenHash; SHA-256 only']
  ProfileKind SchoolBotProfileKind [null, note: 'student หรือ employee เพื่อเลือกชนิด profile; null พร้อม ProfileId ก่อน Desktop bind หรือกรณี legacy admin ที่ไม่มี employee profile | ข้อกำหนดเดิม: student|employee; Desktop allows both student and employee for learning/trying only per decisions-025/026']
  ProfileId int4 [null, note: 'รหัส TUser.sID เมื่อ kind=student หรือ TEmployees.sEmp เมื่อ kind=employee ใช้ SchoolId ประกอบเสมอ; null พร้อม ProfileKind | ข้อกำหนดเดิม: Legacy student SId or employee SEmp selected by ProfileKind and SchoolId']
  LegacyAdminId varchar(64) [null, note: 'รหัสผู้ดูแลเดิมจากตัวตนเว็บที่ตรวจแล้ว เมื่อใช้กรณี legacy admin; null เมื่อไม่มีรหัสนี้ ห้ามแปลงเป็น sEmp เอง | ข้อกำหนดเดิม: Optional TAdmins.id from gateway web-principal when Channel = school_web']
  DeviceJkt varchar(64) [null, note: 'ลายนิ้วมือ device key ที่ผูก session Desktop; ต้องมีใน desktop และต้อง null ใน school_web/staff_admin | ข้อกำหนดเดิม: NOT NULL iff Channel = desktop; NULL when school_web or staff_admin']
  SourceTokenExpiresAt timestamptz [null, note: 'เวลา UTC หมดอายุของ token เว็บต้นทาง; null เมื่อไม่มีเวลา exp จากต้นทางหรือช่องทางนั้นไม่ใช้ token เว็บ | ข้อกำหนดเดิม: Optional exp of source web token when exchanged via DES-012']
  ExpiresAt timestamptz [not null, note: 'เวลา UTC ที่ session SchoolBot หมดอายุ แม้ token ต้นทางไม่มี exp ก็ยังต้องมีอายุ session นี้']
  RevokedAt timestamptz [null, note: 'เวลา UTC ที่เพิกถอน session เช่น logout; null หมายถึงยังไม่มีการเพิกถอน แต่ session อาจหมดอายุแล้ว']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotSession_SchoolId_Pos: SchoolId > 0']

  Note: 'หน้าที่: เก็บ session เข้าใช้งานที่หมดอายุและเพิกถอนได้ โดยใช้บัญชีเดิม; ไม่ใช่ SchoolBotUser | หนึ่งแถว: หนึ่ง session สำหรับช่องทางหนึ่งและโรงเรียนหนึ่ง | ใช้เมื่อ: Desktop login/bind profile; เว็บแลก token; API ตรวจ session; logout/revoke | ตัวอย่าง: สมมติ: บัญชี Master เลข 900 เลือก profile นักเรียนเลข 120 ของโรงเรียน ก; AccountId และ ProfileId มีหน้าที่คนละอย่าง | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-006.md | ข้อกำหนดเดิม: SchoolBot DB (DES-004 Rev5, DES-012 Rev2). ProfileKind/ProfileId ต้อง null พร้อมกันหรือ non-null พร้อมกัน. Channel=desktop ต้องมี DeviceJkt และ AccountId และ bind ได้ทั้ง student/employee (ใช้เรียน/ลองเท่านั้น). Channel=school_web ต้องมี License โรงเรียนที่ active และ DeviceJkt IS NULL. Channel=staff_admin ต้องมี StaffRole active และ DeviceJkt IS NULL.'
}

Table SchoolBotStaffRole [headercolor: #7C3AED] {
  SchoolBotStaffRoleId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotStaffRole (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  EmployeeId int4 [not null, note: 'TEmployees.sEmp ของผู้รับสิทธิ์ ใช้ร่วมกับ SchoolId ต้นสังกัด ไม่ใช่ Master AccountId | ข้อกำหนดเดิม: Legacy employee SEmp within home SchoolId']
  Role SchoolBotStaffRoleName [not null, note: 'content_author=สร้างเนื้อหา, content_approver=อนุมัติเนื้อหา, level_policy_admin=ตั้งเกณฑ์ Level, license_admin=จัดการ License, release_publisher=เผยแพร่ซอฟต์แวร์, dashboard_viewer=ดู dashboard, staff_admin=จัดการสิทธิ์ส่วนกลาง']
  ValidFrom timestamptz [not null, note: 'เวลา UTC เริ่มใช้สิทธิ์บทบาทนี้']
  ValidUntil timestamptz [null, note: 'เวลา UTC สิ้นสุดสิทธิ์ ต้องหลัง ValidFrom; null หมายถึงไม่ตั้งวันสิ้นสุด แต่ยังถอนได้']
  Reason varchar(1000) [not null, note: 'เหตุผลการมอบบทบาท เพื่อให้ตรวจสอบการให้สิทธิ์ย้อนหลังได้']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Home SchoolId (> 0) of the staff employee account']

  Note: 'หน้าที่: กำหนดสิทธิ์งานส่วนกลางให้พนักงาน SchoolBright เป็นรายบทบาท | หนึ่งแถว: สิทธิ์หนึ่งบทบาทของพนักงานหนึ่งคนในโรงเรียนต้นสังกัดหนึ่ง | ใช้เมื่อ: ผู้ดูแลมอบ/ถอนสิทธิ์; admin API ตรวจบทบาทและช่วงเวลาที่มีผล | ตัวอย่าง: สมมติ: พนักงานคนหนึ่งเป็น content_author แต่อีกคนเป็น content_approver | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-007.md | ข้อกำหนดเดิม: SchoolBot DB (DES-012 Rev2). สิทธิ์พนักงานส่วนกลางของ SchoolBright สำหรับเรียก /v2/admin/* (รวม four-eyes content_author vs content_approver).'
}

Table SchoolBotProject [headercolor: #0891B2] {
  SchoolBotProjectId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotProject (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  OwnerKind SchoolBotProfileKind [not null, note: 'student หรือ employee เพื่อบอกว่ารหัส OwnerId อยู่ในทะเบียนใด; เปลี่ยนเจ้าของชนิดนี้ไม่ได้']
  OwnerId int4 [not null, note: 'รหัส profile เจ้าของ: TUser.sID หรือ TEmployees.sEmp ตาม OwnerKind พร้อม SchoolId | ข้อกำหนดเดิม: Polymorphic legacy profile (student SId or employee SEmp) within SchoolId']
  Mode SchoolBotMode [not null, note: 'block, arm หรือ code กำหนดชนิดเนื้อหาและเครื่องมือเปิดงาน; เปลี่ยนโหมดของโครงงานเดิมไม่ได้']
  Name varchar(200) [not null, note: 'ชื่อที่ผู้ใช้เห็น ความยาวไม่เกิน 200 ตัวอักษร ไม่ใช้เป็น filesystem path']
  CurrentRevision int4 [not null, note: 'เลขลำดับ Revision ปัจจุบันใน SchoolBotProjectRevision ของ Project นี้; ไม่ใช่ SchoolBotProjectRevisionId | ข้อกำหนดเดิม: Positive revision number, not a revision row ID']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotProject_SchoolId_Pos: SchoolId > 0']

  Note: 'หน้าที่: เก็บตัวโครงงาน Cloud ชื่อ เจ้าของ โหมด และ pointer ไปฉบับปัจจุบัน | หนึ่งแถว: หนึ่งโครงงานของหนึ่ง profile โดยมี revision เนื้อหาได้หลายฉบับ | ใช้เมื่อ: สร้าง เปิด เปลี่ยนชื่อ บันทึก สำเนา และ soft delete โครงงาน | ตัวอย่าง: สมมติ: นักเรียนมีโครงงาน Block ชื่อ เดินไปถึงธง และบันทึกแล้ว 3 revision | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-008.md | ข้อกำหนดเดิม: SchoolBot DB (DES-003). OwnerKind/OwnerId/SchoolId และ Mode เปลี่ยนไม่ได้; FK_SchoolBotProject_CurrentRevision เป็น DEFERRABLE INITIALLY DEFERRED.'
}

Table SchoolBotProjectRevision [headercolor: #0891B2] {
  SchoolBotProjectRevisionId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotProjectRevision (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  ProjectId int4 [not null, note: 'FK ไป SchoolBotProject เจ้าของ snapshot']
  Revision int4 [not null, note: 'เลขลำดับฉบับภายใน Project เริ่มจาก 1; คู่ ProjectId/Revision ไม่ซ้ำ']
  Content jsonb [not null, note: 'JSON เนื้อหาตาม DES-003: code เก็บ source, block เก็บ stacks/blocks, arm เก็บ poses/order/groups และค่าการเล่น; duration ของ Arm เป็น milliseconds ไม่เก็บสถานะเชื่อมต่อเป็นผลจริงถาวร | ข้อกำหนดเดิม: DES-003 ProjectContent tagged union']
  ContentHash varchar(64) [not null, note: 'SHA-256 ของเนื้อหา ใช้ระบุตรวจความตรงกันของ snapshot ไม่ใช่คะแนนหรือหลักฐานว่ารันผ่าน']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotProjectRevision_SchoolId_Pos: SchoolId > 0']

  indexes {
    (ProjectId, Revision) [unique, name: 'UQ_SchoolBotProjectRevision_ProjectId_Revision']
  }

  Note: 'หน้าที่: เก็บเนื้อหาโครงงานแต่ละฉบับแบบ immutable เพื่อเปิดย้อนหลังและส่งงานฉบับที่แน่นอน | หนึ่งแถว: หนึ่ง snapshot ของโครงงานหนึ่ง ณ เลข Revision หนึ่ง | ใช้เมื่อ: การบันทึกสร้าง revision ใหม่; เปิดงาน/ทำสำเนา/ตรวจงานอ่าน snapshot | ตัวอย่าง: สมมติ: งานที่ส่งอ้าง revision 3 แม้เจ้าของจะบันทึก revision 4 ภายหลัง | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-009.md | ข้อกำหนดเดิม: SchoolBot DB (DES-003). Immutable revision snapshot.'
}

Table SchoolBotLevel [headercolor: #059669] {
  SchoolBotLevelId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotLevel (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
