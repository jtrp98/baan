  Code varchar(64) [not null, unique, note: 'รหัสระดับสำหรับสื่อสารและค้นหา เช่น BEGINNER; ไม่ซ้ำ | ข้อกำหนดเดิม: UQ_SchoolBotLevel_Code']
  Ordinal int4 [not null, unique, note: 'ลำดับระดับตั้งแต่ 1 ใช้เรียงก่อนหลัง; ไม่ใช่เลขชั้น ป./ม. | ข้อกำหนดเดิม: UQ_SchoolBotLevel_Ordinal']
  Title jsonb [not null, note: 'JSON ชื่อระดับหลายภาษาแบบ Text มี default_locale และข้อความ th/en/zh; ภาษาหลักต้องมีข้อความ | ข้อกำหนดเดิม: Text localized object']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Global content only; CHECK (SchoolId IS NULL)']

  Note: 'หน้าที่: กำหนดระดับหลักสูตรกลางและลำดับความก้าวหน้า ไม่ใช่ชั้นเรียนในทะเบียนนักเรียน | หนึ่งแถว: หนึ่งระดับหลักสูตรกลาง เช่น Beginner | ใช้เมื่อ: ส่วนกลางจัดระดับ; หลักสูตรอ้างระดับ; ระบบเสนอ Level ถัดไป | ตัวอย่าง: สมมติ: ห้อง ป.4 เรียน Level Beginner ได้โดยไม่ได้เปลี่ยนทะเบียนเป็นชั้นอื่น | ขอบเขต: ข้อมูลส่วนกลาง: SchoolId ต้องเป็น NULL; โรงเรียนใช้เนื้อหาร่วมกัน | คู่มือ: data-dictionary/table-010.md | ข้อกำหนดเดิม: SchoolBot DB (DES-005 Rev5, DES-011 Rev3). แกนระดับหลักสูตรกลาง Beginner -> Expert; SchoolId ต้องเป็น NULL เสมอ.'
}

Table SchoolBotLevelPromotionPolicy [headercolor: #059669] {
