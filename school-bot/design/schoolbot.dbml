}

Table SchoolBotActivity [headercolor: #059669] {
  SchoolBotActivityId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotActivity (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  LessonId int4 [not null, note: 'FK ไป SchoolBotLesson เจ้าของกิจกรรม']
  ActivityKey uuid [not null, note: 'UUID ถาวรของกิจกรรมข้าม curriculum revision | ข้อกำหนดเดิม: Stable logical activity key across revisions']
  Ordinal int4 [not null, note: 'ลำดับกิจกรรมภายใน Lesson; ไม่ซ้ำใน Lesson เดียวกัน']
  Title jsonb [not null, note: 'ชื่อกิจกรรมหลายภาษาแบบ Text ใช้แสดงให้ผู้เรียนและครูเลือก']
  Type SchoolBotActivityType [not null, note: 'instruction=อ่าน/ดูสื่อ, project=ทำและส่งโครงงาน, quiz=แบบฝึกทดสอบ, test=การสอบ | ข้อกำหนดเดิม: instruction|project|quiz|test']
  Mode SchoolBotMode [null, note: 'block, arm หรือ code เฉพาะ Type=project; null สำหรับ instruction/quiz/test | ข้อกำหนดเดิม: NOT NULL when Type = project; NULL when instruction|quiz|test']
  Indicators jsonb [not null, note: 'JSON รายตัวชี้วัดกลางของกิจกรรม มี indicator_key, code, title; ไม่ใช่ PGTAssessment | ข้อกำหนดเดิม: Indicator[] {indicator_key, code, title}']
  Config jsonb [not null, note: 'JSON รายละเอียดตามชนิด: instruction-v1 เก็บคำแนะนำและสื่อ, project-v1 อ้าง mission_id, question-v1 อ้าง bank_id/question_keys/default_policy; policy มีจำนวนครั้ง วิธีเลือกคะแนน เวลาเป็นวินาที เวลาเปิดเฉลย และการสุ่ม | ข้อกำหนดเดิม: ActivityConfig: instruction-v1 | project-v1 | question-v1 (with default_policy: AssessmentPolicy)']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Global content only; CHECK (SchoolId IS NULL)']

  indexes {
    (LessonId, ActivityKey) [unique, name: 'UQ_SchoolBotActivity_Lesson_ActivityKey']
    (LessonId, Ordinal) [unique, name: 'UQ_SchoolBotActivity_Lesson_Ordinal']
  }

  Note: 'หน้าที่: นิยามหน่วยกิจกรรมที่ผู้เรียนพบในบทเรียน ทั้งการอ่าน โครงงาน Quiz และ Test | หนึ่งแถว: กิจกรรมหนึ่งรายการภายใต้ Lesson หนึ่ง; เฉพาะชนิด project จึงอ้าง Mission | ใช้เมื่อ: แสดงลำดับกิจกรรม; เปิดให้ห้องเรียนทำ; ติดตามผล; เลือกแหล่งคะแนนสำหรับ mapping | ตัวอย่าง: สมมติ: บทหนึ่งมี instruction ตามด้วย project แบบ Block และ quiz | ขอบเขต: ข้อมูลส่วนกลาง: SchoolId ต้องเป็น NULL; โรงเรียนใช้เนื้อหาร่วมกัน | คู่มือ: data-dictionary/table-016.md | ข้อกำหนดเดิม: SchoolBot DB (DES-005 Rev5, DES-010 Rev3). กิจกรรมรายคาบ/บทเรียนในหลักสูตรกลาง.'
}

Table SchoolBotQuestionBank [headercolor: #059669] {
  SchoolBotQuestionBankId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotQuestionBank (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  BankKey uuid [not null, note: 'UUID ของคลังข้อสอบที่คงเดิมข้าม revision']
  Revision int4 [not null, note: 'เลขฉบับคลัง; เผยแพร่แล้วไม่ย้อนแก้ข้อสอบที่ Attempt เคยใช้']
  Title jsonb [not null, note: 'ชื่อคลังข้อสอบหลายภาษาแบบ Text']
  Questions jsonb [not null, note: 'JSON array ของข้อสอบ มี question_key, kind, prompt, options, correct_option_keys และ max_score; kind รองรับ single_choice/boolean, คะแนนเต็มเป็น DecimalString มากกว่า 0 และเฉลยไม่ส่งให้ผู้เรียนก่อนเวลาที่อนุญาต | ข้อกำหนดเดิม: Question[] (single_choice | boolean); contains protected correct_option_keys']
  SourceRef varchar(2048) [not null, note: 'แหล่งอ้างอิงข้อสอบสำหรับตรวจที่มาและความถูกต้อง']
  Lifecycle SchoolBotContentState [not null, note: 'draft=ร่าง, published=เผยแพร่ผ่านการอนุมัติ, retired=เลิกใช้ใหม่แต่คงประวัติ']
  PublishedAt timestamptz [null, note: 'เวลา UTC เผยแพร่คลัง; null เมื่อยังไม่มีการเผยแพร่ และต้องมีค่าเมื่อ published']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Global content only; CHECK (SchoolId IS NULL)']

  indexes {
    (BankKey, Revision) [unique, name: 'UQ_SchoolBotQuestionBank_BankKey_Revision']
  }

  Note: 'หน้าที่: เก็บคลังข้อสอบกลางเป็นฉบับ เพื่อให้ Quiz/Test ใช้ข้อสอบและเฉลยที่ตรวจสอบย้อนหลังได้ | หนึ่งแถว: หนึ่ง revision ของคลังข้อสอบหนึ่งชุด | ใช้เมื่อ: ส่วนกลางสร้าง/อนุมัติคลัง; Activity เลือกข้อ; Attempt snapshot คัดลอกข้อที่ใช้จริง | ตัวอย่าง: สมมติ: คลัง ลำดับคำสั่ง revision 1 มีข้อเลือกตอบและข้อถูก/ผิด | ขอบเขต: ข้อมูลส่วนกลาง: SchoolId ต้องเป็น NULL; โรงเรียนใช้เนื้อหาร่วมกัน | คู่มือ: data-dictionary/table-017.md | ข้อกำหนดเดิม: SchoolBot DB (DES-010 Rev3). คลังข้อสอบกลางแบบ revision; publish ต้องผ่าน four-eyes; immutable หลัง publish.'
}

Table SchoolBotCourseRun [headercolor: #D97706] {
  SchoolBotCourseRunId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotCourseRun (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  CurriculumId int4 [not null, note: 'FK ไป SchoolBotCurriculum ฉบับที่เลือกใช้; ไม่เปลี่ยนฉบับกลางทางของ run เดิม']
  ClassroomId int4 [not null, note: 'รหัสห้อง TTermSubLevel2.nTermSubLevel2 ใช้ร่วมกับ SchoolId และบริบทปี/เทอม | ข้อกำหนดเดิม: Legacy NTermSubLevel2 within SchoolId']
  NYear int4 [not null, note: 'รหัสปีจากระบบเดิม ใช้เชื่อม TYear.nYear และ TTerm.nYear; ไม่ใช่ numberYear ที่แสดง เช่น 2569 โดยอัตโนมัติ']
  NTerm varchar(64) [not null, note: 'รหัสเทอมเดิมชนิดข้อความจาก TTerm.nTerm; ไม่ใช่การใส่เลข 1 หรือ 2 โดยไม่ resolve | ข้อกำหนดเดิม: Legacy TTerm.NTerm']
  PlanCourseIds integer[] [not null, note: 'integer[] ของ TPlanCourse.PlanCourseId ที่ผูก run; ต้องมีอย่างน้อยหนึ่งรายการ ไม่มี null และตามสัญญาต้องไม่ซ้ำและตรงห้อง/เทอม | ข้อกำหนดเดิม: Logical I[] (>=1 unique PlanCourseIds); physical DDL in schoolbot_db.sql uses integer[] (int4[]) with cardinality >= 1']
  CurrentPolicyId int4 [null, note: 'FK ไป SchoolBotScoringPolicy; null เฉพาะร่างก่อนเปิด; freeze เมื่อ active']
  PreviousRunId int4 [null, note: 'FK ไป CourseRun ก่อนหน้าที่นำมาสู่ run นี้; null เมื่อไม่ใช่ successor']
  EffectiveAt timestamptz [not null, note: 'เวลา UTC ที่การเปิดใช้ run นี้มีผล รวมกรณี run เทอมถัดไปจากการตัดสิน Level']
  Lifecycle SchoolBotCourseRunState [not null, note: 'planned=เตรียมเปิด, active=กำลังใช้, closing=กำลังปิดเทอม, closed=ปิดแล้ว | ข้อกำหนดเดิม: planned|active|closing|closed']
  IsDelete boolean [not null, default: false, note: 'ระบุว่าแถวถูกลบแบบเก็บประวัติหรือไม่; false = ยังใช้, true = ซ่อนจากการอ่านตามปกติ ไม่ใช่การลบข้อมูลถาวร; ค่าเริ่มต้นใน SQL = false']
  CreateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้สร้างรายการ; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ เลขอย่างเดียวไม่บอกชนิดคน ให้ดู Actor ใน AuditEvent ประกอบ']
  CreateDate timestamptz [not null, note: 'วันเวลาสร้างรายการตามเวลา UTC จาก server']
  UpdateBy int4 [null, note: 'รหัสนักเรียน sId หรือบุคลากร sEmp ผู้แก้ล่าสุด; NULL = ระบบ/ผู้ทำที่ไม่มีรหัส profile นี้ ใช้กฎเดียวกับ CreateBy']
  UpdateDate timestamptz [not null, note: 'วันเวลาแก้ล่าสุด UTC จาก server; ใช้ตรวจว่ามีคนแก้แทรกก่อนบันทึกผ่าน ETag/If-Match แทนคอลัมน์ Version']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotCourseRun_SchoolId_Pos: SchoolId > 0']

  Note: 'หน้าที่: นำหลักสูตรกลางฉบับหนึ่งมาเปิดใช้จริงกับห้อง ปี และเทอมของโรงเรียน | หนึ่งแถว: การเปิดใช้ curriculum revision หนึ่งกับห้องหนึ่งในปี/เทอมหนึ่ง | ใช้เมื่อ: ผู้ดูแลโรงเรียนเปิด/ปิดหลักสูตร; ครูตั้งคะแนนและกิจกรรม; ตรวจ roster, mapping, export และการต่อ Level | ตัวอย่าง: สมมติ: ห้อง ป.4/1 ใช้ Beginner revision 2 ในเทอมที่เลือก และผูกวิชาวิทยาการคำนวณของห้องนั้น | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-018.md | ข้อกำหนดเดิม: SchoolBot DB (DES-008 Rev3, DES-010 Rev3, DES-011 Rev3). การเปิดใช้หลักสูตรกลางกับห้อง/ปี/เทอมและชุดวิชา PlanCourseIds ของโรงเรียน; FK_SchoolBotCourseRun_CurrentPolicy เป็น DEFERRABLE INITIALLY DEFERRED.'
}

Table SchoolBotScoringPolicy [headercolor: #D97706] {
  SchoolBotScoringPolicyId int4 [pk, increment, not null, note: 'รหัสแถวของ SchoolBotScoringPolicy (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
