// SchoolBot integration — Rev3: logical references only
// Change Log: 2026-10-26 — คง PK ของตาราง SchoolBot; เปลี่ยน4FKเดิมเป็นlogical ไม่มีphysicalFK
// Change Log: 2026-10-23 — Notes เท่านั้น structure เดิม; ผู้คุมตรวจ parser หลังบันทึก
// Change Log: 2026-10-23 — ภาพย่อจุดเชื่อมข้อมูลเดิม; ไม่ใช่ DDL และไม่เพิ่ม FK ข้าม DB
Project SchoolBotIntegration {
  database_type: 'PostgreSQL'
  Note: '''
  เริ่มอ่านจาก Session/Project/CourseRun แล้วดู GradeSlot และ ScoreOutbox. ภาพนี้แสดงเฉพาะฟิลด์สำคัญ ไม่ใช่ schema ครบ.
  สีน้ำเงิน = SchoolBot ใหม่; ม่วง = บัญชี Master เดิม; เขียว = ข้อมูล School เดิม; ส้ม = คะแนน PGGradeDB เดิม.
  ทุกเส้น LOGICAL_* เป็นการอ้างอิงเชิงตรรกะเท่านั้น (16เส้น); ร่าง SQL ไม่มี physical FK. PK ของ SchoolBot ยังคงอยู่.
  LegacyMaster/LegacySchool/LegacyGrade เป็น namespace ของภาพเพื่อแยกฐานข้อมูล ไม่ใช่ชื่อ schema ที่ใช้ deploy.
  ห้ามนำไฟล์ภาพ integration นี้ไปสร้าง SQL/migration. แบบครบ 32 ตาราง/450 ฟิลด์/PK32 และ FK0 อยู่ที่ schoolbot.dbml.
  กฎ032..034: employee มี Project Cloud แต่ไม่มีผล Cloud รวม import; ช่องเดิมเท่านั้นและ ownership ที่ confirm แล้วคงประวัติรวม partial/pending. อ่าน grade-rules-032-034.md และ learning-rules-032-034.md; ไม่เพิ่ม field/ref.
  AccountId ไม่เท่ากับรหัสนักเรียน/ครู; ไม่วาด account-profile join ที่ยังพิสูจน์ไม่ได้.
  '''
}

Table SchoolBotSession [headercolor: #2563EB] {
  SchoolBotSessionId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotSession (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  Channel varchar(16) [not null, note: 'desktop=เรียน/ทดลอง, school_web=งานโรงเรียน, staff_admin=งานส่วนกลาง; ใช้จำกัด endpoint ที่เรียกได้; ค่าเริ่มต้นใน SQL = \'desktop\' | ข้อกำหนดเดิม: desktop|school_web|staff_admin']
  AccountId int4 [null, note: 'รหัสบัญชี TMasterDBUser.sID; Desktop ต้องมีค่า ส่วนช่องเว็บอาจ null; ห้ามถือว่าเท่ากับ TUser.sID หรือ TEmployees.sEmp | ข้อกำหนดเดิม: Legacy Master TMasterDBUser.sID; NOT NULL when Channel = desktop']
  ProfileKind varchar(16) [null, note: 'student หรือ employee เพื่อเลือกชนิด profile; null พร้อม ProfileId ก่อน Desktop bind หรือกรณี legacy admin ที่ไม่มี employee profile | ข้อกำหนดเดิม: student|employee; Desktop allows both student and employee for learning/trying only per decisions-025/026']
  ProfileId int4 [null, note: 'รหัส TUser.sID เมื่อ kind=student หรือ TEmployees.sEmp เมื่อ kind=employee ใช้ SchoolId ประกอบเสมอ; null พร้อม ProfileKind | ข้อกำหนดเดิม: Legacy student SId or employee SEmp selected by ProfileKind and SchoolId']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotSession_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บ session เข้าใช้งานที่หมดอายุและเพิกถอนได้ โดยใช้บัญชีเดิม; ไม่ใช่ SchoolBotUser | หนึ่งแถว: หนึ่ง session สำหรับช่องทางหนึ่งและโรงเรียนหนึ่ง | ใช้เมื่อ: Desktop login/bind profile; เว็บแลก token; API ตรวจ session; logout/revoke | ตัวอย่าง: สมมติ: บัญชี Master เลข 900 เลือก profile นักเรียนเลข 120 ของโรงเรียน ก; AccountId และ ProfileId มีหน้าที่คนละอย่าง | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-006.md | ข้อกำหนดเดิม: SchoolBot DB (DES-004 Rev5, DES-012 Rev2). ProfileKind/ProfileId ต้อง null พร้อมกันหรือ non-null พร้อมกัน. Channel=desktop ต้องมี DeviceJkt และ AccountId และ bind ได้ทั้ง student/employee (ใช้เรียน/ลองเท่านั้น). Channel=school_web ต้องมี License โรงเรียนที่ active และ DeviceJkt IS NULL. Channel=staff_admin ต้องมี StaffRole active และ DeviceJkt IS NULL. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotStaffRole [headercolor: #2563EB] {
  SchoolBotStaffRoleId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotStaffRole (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  EmployeeId int4 [not null, note: 'TEmployees.sEmp ของผู้รับสิทธิ์ ใช้ร่วมกับ SchoolId ต้นสังกัด ไม่ใช่ Master AccountId | ข้อกำหนดเดิม: Legacy employee SEmp within home SchoolId']
  Role varchar(32) [not null, note: 'content_author=สร้างเนื้อหา, content_approver=อนุมัติเนื้อหา, level_policy_admin=ตั้งเกณฑ์ Level, license_admin=จัดการ License, release_publisher=เผยแพร่ซอฟต์แวร์, dashboard_viewer=ดู dashboard, staff_admin=จัดการสิทธิ์ส่วนกลาง']
  ValidFrom timestamptz [not null, note: 'เวลา UTC เริ่มใช้สิทธิ์บทบาทนี้']
  ValidUntil timestamptz [null, note: 'เวลา UTC สิ้นสุดสิทธิ์ ต้องหลัง ValidFrom; null หมายถึงไม่ตั้งวันสิ้นสุด แต่ยังถอนได้']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: Home SchoolId (> 0) of the staff employee account']
  Note: 'ภาพย่อ: หน้าที่: กำหนดสิทธิ์งานส่วนกลางให้พนักงาน SchoolBright เป็นรายบทบาท | หนึ่งแถว: สิทธิ์หนึ่งบทบาทของพนักงานหนึ่งคนในโรงเรียนต้นสังกัดหนึ่ง | ใช้เมื่อ: ผู้ดูแลมอบ/ถอนสิทธิ์; admin API ตรวจบทบาทและช่วงเวลาที่มีผล | ตัวอย่าง: สมมติ: พนักงานคนหนึ่งเป็น content_author แต่อีกคนเป็น content_approver | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-007.md | ข้อกำหนดเดิม: SchoolBot DB (DES-012 Rev2). สิทธิ์พนักงานส่วนกลางของ SchoolBright สำหรับเรียก /v2/admin/* (รวม four-eyes content_author vs content_approver). | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotProject [headercolor: #2563EB] {
  SchoolBotProjectId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotProject (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  OwnerKind varchar(16) [not null, note: 'student หรือ employee เพื่อบอกว่ารหัส OwnerId อยู่ในทะเบียนใด; เปลี่ยนเจ้าของชนิดนี้ไม่ได้']
  OwnerId int4 [not null, note: 'รหัส profile เจ้าของ: TUser.sID หรือ TEmployees.sEmp ตาม OwnerKind พร้อม SchoolId | ข้อกำหนดเดิม: Polymorphic legacy profile (student SId or employee SEmp) within SchoolId']
  Mode varchar(16) [not null, note: 'block, arm หรือ code กำหนดชนิดเนื้อหาและเครื่องมือเปิดงาน; เปลี่ยนโหมดของโครงงานเดิมไม่ได้']
  Name varchar(200) [not null, note: 'ชื่อที่ผู้ใช้เห็น ความยาวไม่เกิน 200 ตัวอักษร ไม่ใช้เป็น filesystem path']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotProject_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บตัวโครงงาน Cloud ชื่อ เจ้าของ โหมด และ pointer ไปฉบับปัจจุบัน | หนึ่งแถว: หนึ่งโครงงานของหนึ่ง profile โดยมี revision เนื้อหาได้หลายฉบับ | ใช้เมื่อ: สร้าง เปิด เปลี่ยนชื่อ บันทึก สำเนา และ soft delete โครงงาน | ตัวอย่าง: สมมติ: นักเรียนมีโครงงาน Block ชื่อ เดินไปถึงธง และบันทึกแล้ว 3 revision | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-008.md | ข้อกำหนดเดิม: SchoolBot DB (DES-003). OwnerKind/OwnerId/SchoolId และ Mode เปลี่ยนไม่ได้; FK_SchoolBotProject_CurrentRevision เป็น DEFERRABLE INITIALLY DEFERRED. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotCourseRun [headercolor: #2563EB] {
  SchoolBotCourseRunId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotCourseRun (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  CurriculumId int4 [not null, note: 'FK ไป SchoolBotCurriculum ฉบับที่เลือกใช้; ไม่เปลี่ยนฉบับกลางทางของ run เดิม']
  ClassroomId int4 [not null, note: 'รหัสห้อง TTermSubLevel2.nTermSubLevel2 ใช้ร่วมกับ SchoolId และบริบทปี/เทอม | ข้อกำหนดเดิม: Legacy NTermSubLevel2 within SchoolId']
  NYear int4 [not null, note: 'รหัสปีจากระบบเดิม ใช้เชื่อม TYear.nYear และ TTerm.nYear; ไม่ใช่ numberYear ที่แสดง เช่น 2569 โดยอัตโนมัติ']
  NTerm varchar(64) [not null, note: 'รหัสเทอมเดิมชนิดข้อความจาก TTerm.nTerm; ไม่ใช่การใส่เลข 1 หรือ 2 โดยไม่ resolve | ข้อกำหนดเดิม: Legacy TTerm.NTerm']
  PlanCourseIds int4[] [not null, note: 'integer[] ของ TPlanCourse.PlanCourseId ที่ผูก run; ต้องมีอย่างน้อยหนึ่งรายการ ไม่มี null และตามสัญญาต้องไม่ซ้ำและตรงห้อง/เทอม | ข้อกำหนดเดิม: Logical I[] (>=1 unique PlanCourseIds); physical DDL in schoolbot_db.sql uses integer[] (int4[]) with cardinality >= 1']
  Lifecycle varchar(16) [not null, note: 'planned=เตรียมเปิด, active=กำลังใช้, closing=กำลังปิดเทอม, closed=ปิดแล้ว | ข้อกำหนดเดิม: planned|active|closing|closed']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotCourseRun_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: นำหลักสูตรกลางฉบับหนึ่งมาเปิดใช้จริงกับห้อง ปี และเทอมของโรงเรียน | หนึ่งแถว: การเปิดใช้ curriculum revision หนึ่งกับห้องหนึ่งในปี/เทอมหนึ่ง | ใช้เมื่อ: ผู้ดูแลโรงเรียนเปิด/ปิดหลักสูตร; ครูตั้งคะแนนและกิจกรรม; ตรวจ roster, mapping, export และการต่อ Level | ตัวอย่าง: สมมติ: ห้อง ป.4/1 ใช้ Beginner revision 2 ในเทอมที่เลือก และผูกวิชาวิทยาการคำนวณของห้องนั้น | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-018.md | ข้อกำหนดเดิม: SchoolBot DB (DES-008 Rev3, DES-010 Rev3, DES-011 Rev3). การเปิดใช้หลักสูตรกลางกับห้อง/ปี/เทอมและชุดวิชา PlanCourseIds ของโรงเรียน; FK_SchoolBotCourseRun_CurrentPolicy เป็น DEFERRABLE INITIALLY DEFERRED. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotSubmission [headercolor: #2563EB] {
  SchoolBotSubmissionId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotSubmission (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  LearnerId int4 [not null, note: 'TUser.sID ของนักเรียนพร้อม SchoolId; schema ปัจจุบันไม่ใช้ sEmp ของครูแทน | ข้อกำหนดเดิม: Legacy student SId within SchoolId (student only in current schema)']
  MissionId int4 [not null, note: 'FK ไป SchoolBotMission ที่ส่งงานตอบ']
  ProjectRevisionId int4 [not null, note: 'FK ไป SchoolBotProjectRevision ที่ส่งจริง ต้องเป็นของนักเรียนคนนี้และโรงเรียนเดียวกัน ไม่ใช่ local UUID']
  State varchar(24) [not null, note: 'queued=รอระบบตรวจ, grading=กำลังตรวจ, awaiting_teacher=รอครู, evaluated=มีผลแล้ว, error=กระบวนการตรวจผิดพลาด ซึ่งไม่เท่ากับสอบไม่ผ่าน']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotSubmission_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บการส่งโครงงานฉบับแน่นอนให้ตรวจภารกิจ แยกจากการทำข้อสอบใน Attempt | หนึ่งแถว: นักเรียนหนึ่งคนส่ง ProjectRevision หนึ่งเพื่อ Mission และ Criteria ฉบับหนึ่ง | ใช้เมื่อ: นักเรียนส่งงาน; worker/ครูตรวจ; progress และ export อ่านผลประเมินปัจจุบัน | ตัวอย่าง: สมมติ: นักเรียนส่งโครงงาน Arm revision 3 ให้ครูตรวจ และสถานะเป็น awaiting_teacher | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-021.md | ข้อกำหนดเดิม: SchoolBot DB (DES-005 Rev5). อ้าง global Mission/Criteria และ ProjectRevision ด้วย single-column FK ชี้ PK; application ตรวจว่า CriteriaId อยู่ใน MissionId เดียวกัน และ ProjectRevision เป็นของนักเรียน (OwnerKind=student) ใน SchoolId เดียวกัน. FK_SchoolBotSubmission_CurrentAssessment เป็น DEFERRABLE INITIALLY DEFERRED. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotAssessment [headercolor: #2563EB] {
  SchoolBotAssessmentId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotAssessment (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  SubmissionId int4 [not null, note: 'FK ไป SchoolBotSubmission ที่ผลนี้ประเมิน']
  AssessorId int4 [null, note: 'TEmployees.sEmp ของครูผู้ตรวจพร้อม SchoolId; ต้องมีเมื่อ teacher และ null เมื่อ automatic | ข้อกำหนดเดิม: Legacy employee SEmp within SchoolId']
  EarnedScore numeric(18,6) [null, note: 'คะแนนที่ได้ชนิด numeric(18,6); null พร้อม MaxScore เมื่อมีเฉพาะผลผ่าน/ยังไม่ผ่าน; เมื่อมีค่าต้องอยู่ระหว่าง 0 ถึง MaxScore | ข้อกำหนดเดิม: Null together with MaxScore, or 0 <= EarnedScore <= MaxScore and MaxScore > 0']
  MaxScore numeric(18,6) [null, note: 'คะแนนเต็มชนิด numeric(18,6) ต้องมากกว่า 0 เมื่อมีคะแนน; null พร้อม EarnedScore และกรณีนี้ส่งเป็นคะแนนตัวเลขไม่ได้']
  Outcome varchar(16) [not null, note: 'passed=ผ่านเกณฑ์, not_yet=ยังไม่ผ่าน; ไม่แปลงเป็นคะแนนเต็มหรือศูนย์เอง']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotAssessment_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บผลตรวจโครงงานใน SchoolBot แบบมีประวัติ ไม่ใช่หัวช่องคะแนน PGTAssessment | หนึ่งแถว: ผลประเมินหนึ่งครั้งของ Submission หนึ่ง | ใช้เมื่อ: evaluator หรือครูสร้างผล; Submission ชี้ผลปัจจุบัน; progress/mapping/export อ่านผล | ตัวอย่าง: สมมติ: ครูตรวจงาน Arm ได้ 8 จาก 10 แล้วตรวจใหม่เป็นผลอีกแถวที่อ้างผลเดิม | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-023.md | ข้อกำหนดเดิม: SchoolBot DB (DES-005 Rev5). Immutable append-only assessment result; ล็อกแถว SchoolBotSubmission ก่อนสร้างเพื่อจัดสรร Sequence. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotAttempt [headercolor: #2563EB] {
  SchoolBotAttemptId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotAttempt (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  CourseRunId int4 [not null, note: 'FK ไป SchoolBotCourseRun ที่นักเรียนกำลังเรียน']
  ActivityId int4 [not null, note: 'FK ไป SchoolBotActivity ชนิด quiz/test ในหลักสูตรของ run']
  LearnerId int4 [not null, note: 'TUser.sID ของนักเรียนที่อยู่ใน roster พร้อม SchoolId; ไม่ใช่บัญชี Master หรือ sEmp | ข้อกำหนดเดิม: Legacy student SId within SchoolId (student only in current schema)']
  EarnedScore numeric(18,6) [null, note: 'คะแนนที่ server ประเมินชนิด numeric(18,6); null เมื่อยังไม่มีคะแนน ไม่ตีความทุกกรณีเป็น 0']
  MaxScore numeric(18,6) [not null, note: 'คะแนนเต็มของชุดข้อสอบใน Attempt ชนิด numeric(18,6) มากกว่า 0 และไม่เปลี่ยนตามคลังรุ่นใหม่']
  State varchar(16) [not null, note: 'started=กำลังทำ, submitted=ส่งแล้ว, expired=หมดเวลาที่อนุญาต, voided=ยกเลิกความใช้ได้ของครั้งนั้น | ข้อกำหนดเดิม: started|submitted|expired|voided']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotAttempt_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บการเริ่มทำและส่งคำตอบ Quiz/Test แต่ละครั้ง พร้อมข้อสอบที่ตรึงไว้ | หนึ่งแถว: การทำกิจกรรมข้อสอบหนึ่งครั้งของนักเรียนหนึ่งคนใน CourseRun หนึ่ง | ใช้เมื่อ: เริ่มทำข้อสอบ บันทึกคำตอบ ส่งคำตอบ ตรวจคะแนน และเลือกผลตาม policy | ตัวอย่าง: สมมติ: นักเรียนเริ่ม Quiz ครั้งที่ 2 ได้ชุดคำถามตาม snapshot และส่งคำตอบได้ 4 จาก 5 | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-024.md | ข้อกำหนดเดิม: SchoolBot DB (DES-010 Rev3). การทำข้อสอบ Quiz/Test ของนักเรียนพร้อม immutable snapshot. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotGradeSlot [headercolor: #2563EB] {
  SchoolBotGradeSlotId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotGradeSlot (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  CourseRunId int4 [not null, note: 'FK ไป SchoolBotCourseRun ที่ได้รับสิทธิ์ใช้ช่องนี้']
  PlanCourseId int4 [not null, note: 'TPlanCourse.PlanCourseId ของวิชาในแผน ต้องอยู่ใน CourseRun.PlanCourseIds']
  CourseId int4 [not null, note: 'รหัสรายวิชา TPlane.sPlaneID ที่ resolve จากแผน ไม่ใช่ PlanCourseId']
  NGradeId int4 [not null, note: 'PGTGrade.nGradeId ของหัวใบคะแนนปลายทาง พร้อมบริบทโรงเรียน/เทอม/ห้อง/วิชา']
  AssessmentId int4 [not null, note: 'PGTAssessment.AssessmentId ของหัวช่องคะแนนเดิม ไม่ใช่ SchoolBotAssessmentId']
  ScoreIdentifier varchar(128) [not null, note: 'ตัวระบุช่องจริงใน JSON PGTGradeDetail.ScoreData ใช้คู่ AssessmentId; ห้ามสร้างจากเลข Ordinal หรือชื่อช่องเอง']
  Category varchar(32) [not null, note: 'before_midterm=เก็บก่อนกลางภาค, after_midterm=เก็บหลังกลางภาค, midterm=กลางภาค, final=ปลายภาค']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotGradeSlot_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: บันทึกว่าช่องคะแนนเดิมใดได้รับการยืนยันให้ SchoolBot ดูแล โดยไม่ได้สร้างหัวช่องคะแนนเดิมขึ้นใหม่ | หนึ่งแถว: สิทธิ์ดูแลช่องปลายทางหนึ่งช่องที่ระบุด้วย SchoolId/NGradeId/AssessmentId/ScoreIdentifier | ใช้เมื่อ: ผู้ดูแลโรงเรียนยืนยัน ownership; mapping เลือกปลายทาง; preview/worker ตรวจสิทธิ์ช่องก่อนใช้ | ตัวอย่าง: สมมติ: ผู้ดูแลเลือกช่องคะแนนเก็บที่ว่างและยืนยันให้ใช้รับผลจากกิจกรรม SchoolBot | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-026.md | ข้อกำหนดเดิม: SchoolBot DB (DES-008 Rev3). ช่องคะแนนย่อยใน PGGradeDB ที่ school_admin ยืนยันให้ SchoolBot ดูแล. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotScorePreviewItem [headercolor: #2563EB] {
  SchoolBotScorePreviewItemId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotScorePreviewItem (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  ScorePreviewId int4 [not null, note: 'FK ไป SchoolBotScorePreview เจ้าของรายการ']
  LearnerId int4 [not null, note: 'TUser.sID ของนักเรียนใน roster พร้อม SchoolId; คู่ ScorePreviewId/LearnerId ไม่ซ้ำ']
  Snapshot jsonb [not null, note: 'JSON cells รายช่อง เก็บ mapping/slot, TargetSnapshot, grade_detail_id, row_token, old_score, last_exported_score, raw_target, new_score, source refs/hash, ผลพิเศษ และ fingerprints; old_score/last_exported_score=null หมายถึงไม่มีค่าที่บันทึก ไม่ใช่ 0; new_score เป็นจำนวนเต็มหลังปัด half-up; decision เป็น apply/keep_destination/replace_owned | ข้อกำหนดเดิม: DES-009 PreviewItemSnapshot (half-up integer rounding)']
  State varchar(16) [not null, note: 'ready=พร้อมตามการตรวจ preview, conflict=ข้อมูลชนต้องตัดสินใจใหม่, blocked=ไม่ผ่านเงื่อนไขที่ห้ามเขียน | ข้อกำหนดเดิม: ready|conflict|blocked']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotScorePreviewItem_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บรายละเอียด preview รายนักเรียน โดยหนึ่งคนอาจมีหลายช่องคะแนน | หนึ่งแถว: นักเรียนหนึ่งคนใน ScorePreview หนึ่งใบ | ใช้เมื่อ: หน้า preview แสดงผลรายคน; confirm สร้าง Outbox; worker อ่าน snapshot ที่ยืนยัน | ตัวอย่าง: สมมติ: นักเรียน ก มีสองช่องพร้อมส่ง ส่วนนักเรียน ข ถูก block เพราะมี override | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-029.md | ข้อกำหนดเดิม: SchoolBot DB (DES-009 Rev3). รายการ preview/ชน/บล็อกรายนักเรียน. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table SchoolBotScoreOutbox [headercolor: #2563EB] {
  SchoolBotScoreOutboxId int4 [pk, not null, note: 'รหัสแถวของ SchoolBotScoreOutbox (PK); ฐานข้อมูลสร้างให้ ไม่รับรหัสจาก client; เป็น Primary Key ของตารางนี้; สร้างอัตโนมัติแบบ identity']
  ScoreExportId int4 [not null, note: 'FK ไป SchoolBotScoreExport เจ้าของงานส่งออก']
  ScorePreviewItemId int4 [not null, note: 'FK ไป SchoolBotScorePreviewItem ของนักเรียนและ snapshot ที่จะส่ง; application ต้องตรวจว่าอยู่ใน preview ของ export เดียวกัน']
  OperationKey uuid [not null, note: 'UUID ไม่ซ้ำของการเขียนรายคน ใช้ตรวจ durable receipt และกัน replay ข้าม DB | ข้อกำหนดเดิม: UQ_SchoolBotScoreOutbox_OperationKey']
  ReceiptId bigint [null, note: 'logical reference ไป PGTGradeAuditLog.GradeAuditLogId ชนิด bigint/int8; API ส่งเป็น decimal string; null เมื่อยังไม่มี receipt ID ที่บันทึกยืนยัน | ข้อกำหนดเดิม: Logical ref to PGGradeDB PGTGradeAuditLog.GradeAuditLogId; no cross-DB FK']
  State varchar(16) [not null, note: 'queued=รอ, running=กำลังทำ, applied=ยืนยันว่าปลายทางรับแล้ว, skipped=ข้ามตามการตัดสิน, conflict=ข้อมูลชน, blocked=เงื่อนไขห้ามเขียน, unknown=ผลยังไม่แน่ชัดต้อง reconcile']
  SchoolId int4 [not null, note: 'รหัสโรงเรียนที่ข้อมูลแถวนี้สังกัด; ไม่ใช่รหัสผู้ใช้ ดูขอบเขตส่วนกลาง/รายโรงเรียนที่ต้นหน้านี้ | ข้อกำหนดเดิม: CK_SchoolBotScoreOutbox_SchoolId_Pos: SchoolId > 0']
  Note: 'ภาพย่อ: หน้าที่: เก็บงานเขียนคะแนนรายนักเรียนและหลักฐานปลายทาง เพื่อ retry/reconcile ข้ามฐานข้อมูลโดยไม่เขียนซ้ำ | หนึ่งแถว: งานของนักเรียนหนึ่งคนใน Export หนึ่งใบ อ้าง PreviewItem ที่ยืนยันแล้ว | ใช้เมื่อ: confirm สร้างงานรายคน; worker claim/apply/retry; reconciliation ตรวจ receipt | ตัวอย่าง: สมมติ: PGGradeDB commit คะแนนสำเร็จแต่ worker หยุดก่อนอัปเดต SchoolBot จึงอ่าน receipt เพื่อกระทบยอด | ขอบเขต: ข้อมูลรายโรงเรียน: SchoolId ต้องมากกว่า 0 และอ่าน/เขียนภายใต้โรงเรียนนั้น | คู่มือ: data-dictionary/table-031.md | ข้อกำหนดเดิม: SchoolBot DB (DES-009 Rev3). Outbox รายนักเรียนสำหรับเขียน PGGradeDB แบบ idempotent คู่กับ xmin CAS ของตาราง PGGradeDB และ PGTGradeAuditLog receipt. | แสดงเฉพาะจุดเชื่อมข้อมูลเดิม; ฟิลด์ที่ละไว้ดู schoolbot.dbml'
}

Table LegacyMaster.TMasterDBUser [headercolor: #7C3AED] {
  sID int [note: 'int รหัสบัญชี Master และ PK; เป็น AccountId ไม่ใช่รหัส profile นักเรียนหรือพนักงาน | sID (SId) | บัญชี']
  nCompany int [note: 'int? รหัสโรงเรียนประกอบบัญชี; null ต้องจัดการตามกฎ directory ที่พิสูจน์แล้ว | nCompany (NCompany) | โรงเรียน; nullable']
  Note: 'ตารางเดิม — บัญชีเดิมที่ใช้เป็นฐานสำหรับ Desktop login; ไม่สร้างบัญชี SchoolBotUser ซ้ำ | ใช้เชื่อม: SchoolBotSession.AccountId → TMasterDBUser.sID; ตรวจ nCompany กับ SchoolBotSession.SchoolId และ resolve profile แยกต่างหาก; ไม่มี FK ข้าม DB | บัญชีเดิม; ไม่ใช่ profile | ภาพแสดงบางฟิลด์ ไม่ใช่ schema ที่สำรวจจากฐานจริง. คู่มือและหลักฐาน: data-dictionary/legacy-001.md'
}

Table LegacySchool.TUser [headercolor: #059669] {
  SchoolID int [note: 'int รหัสโรงเรียน เป็นส่วนหนึ่งของ PK | SchoolID (SchoolId) | โรงเรียน']
  sID int [note: 'int รหัส profile เป็น PK ร่วมกับ SchoolID; ไม่ใช่ Master AccountId โดยอัตโนมัติ | sID (SId) | นักเรียน']
  Note: 'ตารางเดิม — ข้อมูล profile เดิมที่ SchoolBot ใช้อ้างนักเรียน โดยต้องยืนยันชนิดและสิทธิ์ก่อนใช้ | ใช้เชื่อม: SchoolBotSession.ProfileId เมื่อ ProfileKind=student; SchoolBotProject.OwnerId เมื่อ OwnerKind=student; LearnerId ใน Submission/Attempt/RetakeGrant/ScorePreviewItem ใช้ sID พร้อม SchoolId; roster ต้องประกอบ NTerm/ClassroomId | profile; อ่านเท่านั้น | ภาพแสดงบางฟิลด์ ไม่ใช่ schema ที่สำรวจจากฐานจริง. คู่มือและหลักฐาน: data-dictionary/legacy-004.md'
}

Table LegacySchool.TEmployees [headercolor: #059669] {
  SchoolID int [note: 'int โรงเรียนต้นสังกัด เป็นส่วนหนึ่งของ PK | SchoolID (SchoolId) | โรงเรียน']
  sEmp int [note: 'int รหัสบุคลากร เป็น PK ร่วมกับ SchoolID | sEmp (SEmp) | บุคลากร']
  Note: 'ตารางเดิม — profile บุคลากรที่ใช้ระบุตัวครู ผู้ตรวจงาน และพนักงานส่วนกลาง; การมีแถวไม่ได้แปลว่ามีสิทธิ์สอนทุกวิชา | ใช้เชื่อม: SchoolBotSession.ProfileId/SchoolBotProject.OwnerId เมื่อ kind=employee, SchoolBotAssessment.AssessorId และ SchoolBotStaffRole.EmployeeId → sEmp พร้อม SchoolId; สิทธิ์วิชาต้องผ่าน TPlanCourseTeacher | profile; ไม่ได้ให้สิทธิ์วิชาเอง | ภาพแสดงบางฟิลด์ ไม่ใช่ schema ที่สำรวจจากฐานจริง. คู่มือและหลักฐาน: data-dictionary/legacy-005.md'
}

Table LegacySchool.TPlane [headercolor: #059669] {
  SchoolID int [note: 'โรงเรียนเจ้าของวิชา | SchoolID (SchoolId) | โรงเรียน']
  sPlaneID int [note: 'int รหัสวิชา เป็น PK ร่วมกับ SchoolID | sPlaneID (SPlaneId) | วิชา']
  Note: 'ตารางเดิม — ทะเบียนรายวิชาของโรงเรียน เช่น ชื่อและรหัสวิชา ไม่ใช่กิจกรรมหรือหลักสูตรกลาง SchoolBot | ใช้เชื่อม: SchoolBotGradeSlot.CourseId → TPlane.sPlaneID; TPlanCourse.sPlaneID เชื่อมวิชา; ตรวจ SchoolId และ resolve เทอมผ่าน TPlanCourseTerm | ทะเบียนวิชา; อ่าน | ภาพแสดงบางฟิลด์ ไม่ใช่ schema ที่สำรวจจากฐานจริง. คู่มือและหลักฐาน: data-dictionary/legacy-006.md'
