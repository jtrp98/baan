// LOGICAL_04: OwnerKind=student
Ref LOGICAL_04: SchoolBotProject.(SchoolId, OwnerId) > LegacySchool.TUser.(SchoolID, sID) [inactive, color: #EA580C]
// LOGICAL_05: Method=teacher; ตรวจสิทธิ์วิชาเพิ่ม
Ref LOGICAL_05: SchoolBotAssessment.(SchoolId, AssessorId) > LegacySchool.TEmployees.(SchoolID, sEmp) [inactive, color: #EA580C]
// LOGICAL_06: ตรวจปี/เทอม/แผน
Ref LOGICAL_06: SchoolBotCourseRun.(SchoolId, ClassroomId) > LegacySchool.TTermSubLevel2.(SchoolID, nTermSubLevel2) [inactive, color: #EA580C]
// LOGICAL_07: NYear=nYear; varchar(64) เทียบ varchar(20)
Ref LOGICAL_07: SchoolBotCourseRun.(SchoolId, NTerm) > LegacySchool.TTerm.(SchoolID, nTerm) [inactive, color: #EA580C]
// LOGICAL_08: อยู่ใน CourseRun.PlanCourseIds
Ref LOGICAL_08: SchoolBotGradeSlot.(SchoolId, PlanCourseId) > LegacySchool.TPlanCourse.(SchoolID, PlanCourseId) [inactive, color: #EA580C]
// LOGICAL_09: ตรง TPlanCourse.sPlaneID
Ref LOGICAL_09: SchoolBotGradeSlot.(SchoolId, CourseId) > LegacySchool.TPlane.(SchoolID, sPlaneID) [inactive, color: #EA580C]
// LOGICAL_10: ตรวจเทอม/ห้อง/วิชา/PlanId
Ref LOGICAL_10: SchoolBotGradeSlot.(SchoolId, NGradeId) > LegacyGrade.PGTGrade.(SchoolID, nGradeId) [inactive, color: #EA580C]
// LOGICAL_11: nGradeId ต้องตรง NGradeId
Ref LOGICAL_11: SchoolBotGradeSlot.(SchoolId, AssessmentId) > LegacyGrade.PGTAssessment.(SchoolId, AssessmentId) [inactive, color: #EA580C]
// LOGICAL_12: ReceiptId ไม่ null; ตรวจ OperationKey/PayloadHash
Ref LOGICAL_12: SchoolBotScoreOutbox.(SchoolId, ReceiptId) > LegacyGrade.PGTGradeAuditLog.(SchoolId, GradeAuditLogId) [inactive, color: #EA580C]

