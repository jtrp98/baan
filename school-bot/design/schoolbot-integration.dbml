}

Table LegacyGrade.PGTGradeAuditLog [headercolor: #D97706] {
  SchoolId int [note: 'โรงเรียนของ audit; physical ใช้ SchoolId ตาม mapping ที่ตรวจ | SchoolId | โรงเรียน']
  GradeAuditLogId bigint [note: 'long/int8 PK ของ audit; ต้นทางของ SchoolBotScoreOutbox.ReceiptId | GradeAuditLogId | receipt ID']
  Parameter string [note: 'string? ข้อมูลประกอบ audit ที่สัญญาจะใช้เก็บ receipt; ความเข้ากันได้กับ consumer/retention เดิมยังไม่พิสูจน์ | Parameter | ข้อมูล receipt; nullable | string เป็นชนิดเชิงตรรกะของภาพ ไม่ยืนยัน physical varchar/length']
  Note: 'ตารางเดิม — ตาราง audit เดิมของฐานเกรด ซึ่ง DES-009 กำหนดให้ใช้เก็บ durable receipt ของการส่งคะแนน | ใช้เชื่อม: SchoolBotScoreOutbox.ReceiptId → GradeAuditLogId แบบ logical ข้าม DB; ตรวจ SchoolId/OperationKey/PayloadHash ตาม receipt contract | receipt ตามแบบ; INSERT คู่คะแนนใน PGGradeDB transaction | ภาพแสดงบางฟิลด์ ไม่ใช่ schema ที่สำรวจจากฐานจริง. คู่มือและหลักฐาน: data-dictionary/legacy-025.md'
}

