}

Table LegacyGrade.PGTGradeSetting [headercolor: #D97706] {
  SchoolID int [note: 'โรงเรียนเจ้าของการตั้งค่า | SchoolID (SchoolId) | โรงเรียน']
  NYear int [note: 'int รหัสปี; CLR สะกด Nyear แต่ physical เป็น NYear | NYear (Nyear) | รหัสปี']
  ClassLevelId int [note: 'int รหัสระดับชั้นที่ใช้ชุดตั้งค่า; ไม่ใช่ SchoolBotLevel | ClassLevelId | ระดับชั้น']
  IsLocked boolean [note: 'bool ล็อกการตั้งค่า ไม่ควรใช้แทนข้อสรุปว่าคะแนนทุกช่องถูกล็อก | IsLocked | ล็อกการตั้งค่า']
