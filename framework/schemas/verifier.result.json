{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "failure_class": {
      "enum": [
        "",
        "IMPLEMENTATION_FAILURE",
        "TEST_DEFECT",
        "ENVIRONMENT_FAILURE",
        "CONTRACT_MISMATCH"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "proof": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "passed",
          "proof"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "verdict",
    "failure_class",
    "findings",
    "acceptance"
  ],
  "additionalProperties": false
}
