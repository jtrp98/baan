{
  "agents": {
    "claude": {
      "label": "Claude Code",
      "command": "claude",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "--model",
        "<MODEL>"
      ],
      "effortArgs": [
        "--effort",
        "<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "-p",
        "--output-format",
        "text",
        "--permission-mode",
        "plan"
      ],
      "writeArgs": [
        "-p",
        "--output-format",
        "text",
        "--permission-mode",
        "acceptEdits"
      ],
      "answerFrom": "stdout",
      "usage": {
        "args": [
          "--output-format",
          "json"
        ],
        "replaces": [
          "--output-format"
        ],
        "format": "claude-json"
      }
    },
    "codex": {
      "label": "Codex CLI",
      "command": "codex",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "-m",
        "<MODEL>"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort=<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "exec",
        "--skip-git-repo-check",
        "-s",
        "read-only",
        "-o",
        "<ANSWER>",
        "-"
      ],
      "writeArgs": [
        "exec",
        "--skip-git-repo-check",
        "-s",
        "workspace-write",
        "-o",
        "<ANSWER>",
        "-"
      ],
      "answerFrom": "answerFile",
      "usage": {
        "args": [
          "--json"
        ],
        "insertBefore": "-",
        "format": "codex-jsonl"
      }
    },
    "agy": {
      "label": "Agy",
      "command": "agy",
      "useShell": false,
      "promptVia": "stdin",
      "modelArgs": [
        "--model",
        "<MODEL>"
      ],
      "effortArgs": [
        "--effort",
        "<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "--mode",
        "plan",
        "--print"
      ],
      "writeArgs": [
        "--mode",
        "accept-edits",
        "--print"
      ],
      "answerFrom": "stdout",
      "usage": {
        "args": [
          "--output-format",
          "json"
        ],
        "insertBefore": "--print",
        "format": "agy-json"
      }
    }
  },
