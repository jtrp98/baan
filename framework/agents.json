{
  "agents": {
    "claude": {
      "label": "Claude Code",
      "command": "claude",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "--model",
        "<MODEL>"
      ],
      "effortArgs": [
        "--effort",
        "<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "-p",
        "--output-format",
        "text",
        "--permission-mode",
        "plan"
      ],
      "writeArgs": [
        "-p",
        "--output-format",
        "text",
        "--permission-mode",
        "acceptEdits"
      ],
      "answerFrom": "stdout",
      "usage": {
        "args": [
          "--output-format",
          "json"
        ],
        "replaces": [
          "--output-format"
        ],
        "format": "claude-json"
      }
    },
    "codex": {
      "label": "Codex CLI",
      "command": "codex",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "-m",
        "<MODEL>"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort=<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "exec",
        "--skip-git-repo-check",
        "-s",
        "read-only",
        "-o",
        "<ANSWER>",
        "-"
      ],
      "writeArgs": [
        "exec",
        "--skip-git-repo-check",
        "-s",
        "workspace-write",
        "-o",
        "<ANSWER>",
        "-"
      ],
      "answerFrom": "answerFile",
      "usage": {
        "args": [
          "--json"
        ],
        "insertBefore": "-",
        "format": "codex-jsonl"
      }
    },
    "agy": {
      "label": "Agy",
      "command": "agy",
      "useShell": false,
      "promptVia": "stdin",
      "modelArgs": [
        "--model",
        "<MODEL>"
      ],
      "effortArgs": [
        "--effort",
        "<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "--mode",
        "plan",
        "--print"
      ],
      "writeArgs": [
        "--mode",
        "accept-edits",
        "--print"
      ],
      "answerFrom": "stdout",
      "usage": {
        "args": [
          "--output-format",
          "json"
        ],
        "insertBefore": "--print",
        "format": "agy-json"
      }
    }
  },
  "tiers": {
    "t0": {
      "_timeoutSec": 3600,
      "_fallback": [
        "codex",
        "claude"
      ],
      "claude": {
        "model": "opus",
        "effort": "xhigh"
      },
      "codex": {
        "model": "gpt-6-astra",
        "effort": "max"
      },
      "agy": null
    },
    "t1": {
      "_fallback": [
        "codex",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      "agy": {
        "model": "gemini-4-argon",
        "effort": "high"
      }
    },
    "t2": {
      "_fallback": [
        "codex",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "opus",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      "agy": {
        "model": "gemini-4-argon",
        "effort": "medium"
      }
    },
    "t3": {
      "_fallback": [
        "codex",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-6.1-terra",
        "effort": "medium"
      },
      "agy": {
        "model": "gemini-3.8-flash",
        "effort": "medium"
      }
    },
    "t4": {
      "_fallback": [
        "codex",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "haiku",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-6-luna",
        "effort": "medium"
      },
      "agy": {
        "model": "gemini-3.8-flash",
        "effort": "low"
      }
    },
    "t5": {
      "_fallback": [
        "codex",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "haiku",
        "effort": "low"
      },
      "codex": {
        "model": "gpt-6-luna",
        "effort": "low"
      },
      "agy": {
        "model": "gemini-3.8-flash",
        "effort": "low"
      }
    }
  }
}
