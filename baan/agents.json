{
  "agents": {
    "claude": {
      "label": "Claude Code",
      "command": "claude",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "--model",
        "<MODEL>"
      ],
      "effortArgs": [
        "--effort",
        "<EFFORT>"
      ],
      "readArgs": [
        "-p",
        "--output-format",
        "text",
        "--allowedTools",
        "Read,Grep,Glob,LS,Bash(git status:*),Bash(git log:*),Bash(git diff:*),Bash(git show:*),Bash(git rev-parse:*),Bash(git ls-files:*),Bash(ls:*),Bash(cat:*),PowerShell(Get-Content:*),PowerShell(Get-ChildItem:*),PowerShell(Get-Location:*),PowerShell(Select-String:*),PowerShell(git status:*),PowerShell(git log:*),PowerShell(git diff:*),PowerShell(git show:*),PowerShell(git rev-parse:*),PowerShell(git ls-files:*)"
      ],
      "writeArgs": [
        "-p",
        "--output-format",
        "text",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read,Grep,Glob,LS,Edit,MultiEdit,Write,NotebookEdit,Bash,PowerShell"
      ],
      "answerFrom": "stdout"
    },
    "codex": {
      "label": "Codex CLI",
      "command": "codex",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "-m",
        "<MODEL>"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort=<EFFORT>"
      ],
      "readArgs": [
        "exec",
        "--skip-git-repo-check",
        "-s",
        "read-only",
        "-o",
        "<ANSWER>",
        "-"
      ],
      "writeArgs": [
        "exec",
        "--skip-git-repo-check",
        "-s",
        "workspace-write",
        "-o",
        "<ANSWER>",
        "-"
      ],
      "answerFrom": "answerFile"
    },
    "agy": {
      "label": "Agy",
      "command": "agy",
      "useShell": false,
      "promptVia": "arg",
      "modelArgs": [
        "--model",
        "<MODEL>"
      ],
      "effortArgs": [
        "--effort",
        "<EFFORT>"
      ],
      "workspaceDirArgs": [
        "--add-dir",
        "<WORKSPACE_ROOT>"
      ],
      "readArgs": [
        "--agent",
        "baan-readonly",
        "--print"
      ],
      "writeArgs": [
        "--mode",
        "accept-edits",
        "--print"
      ],
      "answerFrom": "stdout"
    },
    "opencode": {
      "label": "OpenCode (Z.AI Coding Plan)",
      "command": "opencode",
      "useShell": true,
      "promptVia": "stdin",
      "modelArgs": [
        "run",
        "-m",
        "<MODEL>"
      ],
      "readArgs": [],
      "writeArgs": [
        "--auto"
      ],
      "answerFrom": "stdout"
    }
  },
  "tiers": {
    "t0": {
      "_timeoutSec": 3600,
      "_fallback": [
        "codex",
        "opencode",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "opus",
        "effort": "max"
      },
      "codex": {
        "model": "gpt-6-astra",
        "effort": "max"
      },
      "agy": {
        "model": "gemini-4-argon-high"
      },
      "opencode": null
    },
    "t1": {
      "_fallback": [
        "codex",
        "opencode",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-6-astra",
        "effort": "high"
      },
      "agy": {
        "model": "gemini-4-argon-high"
      },
      "opencode": null
    },
    "t2": {
      "_fallback": [
        "codex",
        "opencode",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      "agy": {
        "model": "gemini-4-argon-medium"
      },
      "opencode": {
        "model": "zai-coding-plan/glm-5.3#max"
      }
    },
    "t3": {
      "_fallback": [
        "codex",
        "opencode",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-6.1-sol",
        "effort": "low"
      },
      "agy": {
        "model": "gemini-3.8-flash-medium"
      },
      "opencode": {
        "model": "zai-coding-plan/glm-5.3#high"
      }
    },
    "t4": {
      "_fallback": [
        "codex",
        "opencode",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "haiku",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-6-luna",
        "effort": "high"
      },
      "agy": {
        "model": "gemini-3.8-flash-low"
      },
      "opencode": {
        "model": "zai-coding-plan/glm-5.3-flash#max"
      }
    },
    "t5": {
      "_fallback": [
        "codex",
        "opencode",
        "agy",
        "claude"
      ],
      "claude": {
        "model": "haiku",
        "effort": "low"
      },
      "codex": {
        "model": "gpt-6-luna",
        "effort": "medium"
      },
      "agy": {
        "model": "gemini-3.8-flash-low"
      },
      "opencode": {
        "model": "zai-coding-plan/glm-5.3-flash#high"
      }
    }
  }
}
